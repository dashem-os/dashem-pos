# Dashem POS - local Docker environment example
# Copy this file to .env and replace every "change-me" value before use.

# PostgreSQL Configuration
POSTGRES_USER=dashem_pos
POSTGRES_PASSWORD=change-me-local-database-password
POSTGRES_DB=dashem_pos
POSTGRES_PORT=5437

# Backend Configuration
BACKEND_PORT=8002
CONTAINER_PORT=8000
DATABASE_URL=postgresql://dashem_pos:change-me-local-database-password@dashem-pos-db:5432/dashem_pos
SECRET_KEY=change-me-with-a-long-random-secret
ENVIRONMENT=development
