# Dashem POS - local Docker environment example
# Copy this file to .env and replace every "change-me" value before use.

# PostgreSQL Configuration
POSTGRES_USER=dashem_pos
POSTGRES_PASSWORD=change-me-local-database-password
POSTGRES_DB=dashem_pos
POSTGRES_PORT=5437

# Backend Configuration
BACKEND_PORT=8002
CONTAINER_PORT=8000
DATABASE_URL=postgresql://dashem_pos:change-me-local-database-password@dashem-pos-db:5432/dashem_pos
# Prefer a schema-owner connection dedicated to Alembic in hosted environments.
# Local Docker may reuse DATABASE_URL because migrations run before the API.
DATABASE_ADMIN_URL=
RUNTIME_DB_ROLE=dashem_runtime
SECRET_KEY=change-me-with-a-long-random-secret
ENVIRONMENT=development
AUTH_MODE=disabled
# Set AUTH_MODE=required outside the local prototype and provide the project URL.
SUPABASE_URL=https://your-project-ref.supabase.co
# Backend only. Never prefix with VITE_ or expose this value to the browser.
SUPABASE_SECRET_KEY=
SUPABASE_JWT_AUDIENCE=authenticated

# Supabase Storage stays disabled until physical capacity is declared from the
# actual project plan. Free test projects currently use 1073741824 bytes.
SUPABASE_STORAGE_BUCKETS=tenant-assets,tenant-documents,tenant-exports,tenant-integrations
SUPABASE_STORAGE_CAPACITY_BYTES=
SUPABASE_STORAGE_RESERVED_MARGIN_BYTES=0
STORAGE_MAX_UPLOAD_BYTES=5242880
STORAGE_TENANT_WARNING_PERCENT=70
STORAGE_TENANT_CRITICAL_PERCENT=85
APP_URL=http://localhost:5173
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
